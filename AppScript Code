/* 2. 30-MINUTE FOCUS SWITCH & 15-MIN BRAIN BREAK                      */
/*    (trigger every 30 min; active 10:00 AM - 9:30 PM IST)            */
/* ------------------------------------------------------------------ */
function sendThirtyMinuteBrainBreak() {
  const now = new Date();
  const hour = parseInt(Utilities.formatDate(now, CONFIG.TIMEZONE, 'HH'), 10);
  const minute = parseInt(Utilities.formatDate(now, CONFIG.TIMEZONE, 'mm'), 10);
  if (hour < 10 || hour > 21 || (hour === 21 && minute > 35)) return;

  runSafely_('Brain break', function () {
    const modes = [
      'Mental Arithmetic & Fermi Estimation Sprint (5 escalating mental math problems)',
      'Divergent Creativity & Lateral Thinking Challenge (unusual uses or counterfactual synthesis)',
      'Improvisational Storytelling Sprint (give me 3 random constraints to craft a 5-sentence story)',
      'Rapid Devil\'s Advocate Debate (pitch a bold thesis and challenge me to refute it in 4 sentences)',
      'Book Recommendation & Mental Model Micro-Dive (1 high-impact book + a 5-minute exercise)',
      'Logic, Spatial Visualization & Game-Theory Puzzle (1 brain teaser; wait for my answer)'
    ];
    const slotIndex = ((hour - 10) * 2 + (minute >= 30 ? 1 : 0)) % modes.length;
    const timeStr = Utilities.formatDate(now, CONFIG.TIMEZONE, 'hh:mm a');

    const text = callGroq_([{
      role: 'user',
      content:
        '30-Minute Focus Switch (' + timeStr + ' IST): time for a 15-minute whole-brain break!\n' +
        'Current rotation mode: ' + modes[slotIndex] + '.\n' +
        'Generate a fresh, engaging 15-minute interactive exercise for this mode right now, so I shift from work mode ' +
        'to activating another region of my brain. Keep it under 250 words, and end by telling me exactly what to reply with.'
    }], { temperature: 0.9, maxTokens: 700 });

    sendTelegramMessage_('⏰ FOCUS SWITCH — ' + timeStr + ' IST\n\n' + text);
    appendHistory_('assistant', text);
  });
}

