/** Picks an invention not covered before (history kept in Script Properties). */
function pickInvention_() {
  const props = PropertiesService.getScriptProperties();
  let seen = [];
  try { seen = JSON.parse(props.getProperty('SEEN_INVENTIONS') || '[]'); } catch (e) { seen = []; }
  const raw = callGroq_([{
    role: 'user',
    content:
      'Name ONE fascinating invention (historical or modern, from any culture, India included) that would make a ' +
      'great 10-minute lesson. Do NOT pick any of these: ' + (seen.slice(-60).join('; ') || 'none') + '. ' +
      'Reply with only the invention\'s name, nothing else.'
  }], { temperature: 1.0, maxTokens: 30 });
  const name = raw.split('\n')[0].replace(/["*.]/g, '').trim() || 'The printing press';
  seen.push(name);
  props.setProperty('SEEN_INVENTIONS', JSON.stringify(seen.slice(-120)));
  return name;
}

/* ------------------------------------------------------------------ */
/* 4. TELEGRAM WEBHOOK: quiz answers, chat, voice-note speech analysis */
/* ------------------------------------------------------------------ */
function doPost(e) {
  const ok = ContentService.createTextOutput('ok');
  try {
    const update = JSON.parse(e.postData.contents);
    const msg = update.message;
    if (!msg) return ok;
    if (String(msg.chat.id) !== String(getSecret_('TELEGRAM_CHAT_ID'))) return ok;

    // Telegram may re-deliver an update if it does not get a clean 200 in time: ignore repeats.
    const cache = CacheService.getScriptCache();
    const dedupeKey = 'upd_' + update.update_id;
    if (cache.get(dedupeKey)) return ok;
    cache.put(dedupeKey, '1', 21600);

    if (msg.voice) {
      sendTelegramMessage_(handleVoice_(msg.voice));
    } else if (msg.text) {
      sendTelegramMessage_(handleText_(msg.text));
    }
  } catch (err) {
    console.error('Webhook error: ' + err);
    try { sendTelegramMessage_('⚠️ Something went wrong: ' + String(err.message || err).slice(0, 300)); } catch (ignore) {}
  }
  return ok;
}

function handleText_(userText) {
  const messages = loadHistory_().concat([{ role: 'user', content: userText }]);
  const reply = callGroq_(messages, { temperature: 0.7 });
  saveHistory_(messages.concat([{ role: 'assistant', content: reply }]));
  return reply;
}

function handleVoice_(voice) {
  const blob = downloadTelegramFile_(voice.file_id).setName('voice.ogg').setContentType('audio/ogg');
  const stt = transcribe_(blob);
  if (!stt.text) return 'I could not hear any speech in that voice note. Try again a little closer to the mic.';

  const durationSec = stt.duration || voice.duration || 0;
  const wordCount = (stt.text.match(/[A-Za-z0-9\u00C0-\u024F\u0900-\u0DFF']+/g) || []).length;
  const wpm = durationSec > 0 ? Math.round(wordCount / (durationSec / 60)) : null;
  const fillers = countFillers_(stt.text);
  const fillerSummary = Object.keys(fillers.counts).map(function (k) { return k + ' x' + fillers.counts[k]; }).join(', ') || 'none detected';

  const prompt =
    'Analyze my practice speech from the transcript and measured metrics below.\n' +
    'METRICS: duration ' + Math.round(durationSec) + 's, ' + wordCount + ' words, ' +
    (wpm ? wpm + ' words/min (conversational ideal is roughly 130-160)' : 'pace unknown') +
    '; filler words (regex count, approximate; "like" may be legitimate use, and the transcriber can omit some fillers): ' +
    fillers.total + ' [' + fillerSummary + '].\n\n' +
    'TRANSCRIPT:\n' + stt.text + '\n\n' +
    'Give me: 1) a 2-line summary of what I argued, 2) scores out of 10 with one-line reasons for Argument Structure, ' +
    'Pacing (use the WPM), Filler Words, Vocabulary and Rhetorical Impact, 3) three concrete improvements, ' +
    '4) a high-impact rewrite of my core paragraph. Do not comment on tone of voice, since you only have text.';

  const messages = loadHistory_().concat([{ role: 'user', content: prompt }]);
  const reply = callGroq_(messages, { temperature: 0.5, maxTokens: 1800 });
  saveHistory_(messages.concat([{ role: 'assistant', content: reply }]));
  return '🎙️ SPEECH ANALYSIS\n\n' + reply;
}

/** Heuristic filler-word counter. */
function countFillers_(text) {
  const re = /\b(um+|uh+|er+m?|ah+|hmm+|you know|i mean|kind of|sort of|basically|actually|literally|like)\b/gi;
  const counts = {};
  let total = 0;
  let m;
  while ((m = re.exec(text)) !== null) {
    const k = m[1].toLowerCase();
    counts[k] = (counts[k] || 0) + 1;
    total++;
  }
  return { total: total, counts: counts };
}

/* ------------------------------------------------------------------ */
/* GROQ HELPERS                                                        */
/* ------------------------------------------------------------------ */

/**
 * Chat completion with retry + automatic model fallback.
 * @param {Array<{role:string,content:string}>} messages  conversation (system prompt is added here)
 * @param {{temperature?:number,maxTokens?:number}} opts
 * @return {string} assistant text (throws if every model fails)
 */
function callGroq_(messages, opts) {
  opts = opts || {};
  const key = getSecret_('GROQ_API_KEY');
  const models = [CONFIG.MODEL, CONFIG.FALLBACK_MODEL];
  // GPT-OSS models "think" before answering. Those reasoning tokens count toward the completion limit,
  // so we add headroom; otherwise short calls (e.g. 30 tokens) would be eaten by reasoning and return nothing.
  const body = function (model, withReasoningParams) {
    const reasoning = isReasoningModel_(model);
    const payload = {
      model: model,
      messages: [{ role: 'system', content: SYSTEM_INSTRUCTION }].concat(messages),
      temperature: opts.temperature !== undefined ? opts.temperature : CONFIG.TEMPERATURE,
      max_completion_tokens: (opts.maxTokens || CONFIG.MAX_TOKENS) + (reasoning ? CONFIG.REASONING_BUFFER : 0)
    };
    if (reasoning && withReasoningParams) {
      payload.reasoning_effort = CONFIG.REASONING_EFFORT;
      payload.include_reasoning = false;   // keep chain-of-thought out of the reply
    }
    return JSON.stringify(payload);
  };
  let lastError = '';

  for (let m = 0; m < models.length; m++) {
    let withReasoningParams = true;   // dropped automatically if the API rejects them (HTTP 400)
    for (let attempt = 0; attempt < 3; attempt++) {
      const res = UrlFetchApp.fetch(CONFIG.GROQ_BASE + '/chat/completions', {
        method: 'post',
        contentType: 'application/json',
        headers: { Authorization: 'Bearer ' + key },
        payload: body(models[m], withReasoningParams),
        muteHttpExceptions: true
      });
      const code = res.getResponseCode();
      const content = res.getContentText();

      if (code === 200) {
        let text = '';
        try { text = (JSON.parse(content).choices[0].message.content || '').trim(); } catch (ignore) {}
        if (text) return text;
        lastError = models[m] + ': empty response (try raising CONFIG.REASONING_BUFFER)';
        break;
      }

      lastError = models[m] + ' -> HTTP ' + code + ': ' + content.slice(0, 200);
      console.log(lastError);
      if (code === 400 && withReasoningParams && isReasoningModel_(models[m])) {
        withReasoningParams = false;   // retry once without reasoning_effort / include_reasoning
        continue;
      }
      if (attempt < 2 && code === 429) {
        const wait = retryAfterSeconds_(res) || 5;
        if (wait <= 25) { Utilities.sleep(wait * 1000); continue; }
      } else if (attempt < 2 && code >= 500) {
        Utilities.sleep(2000);
        continue;
      }
      break;   // 404 (model not available to you), auth errors, etc. -> try the next model
    }
  }
  throw new Error('Groq unavailable. Last error: ' + lastError);
}

function isReasoningModel_(model) {
  return /gpt-oss/i.test(model);
}

/** Run from the editor: logs the model IDs your Groq key can actually use (copy one into CONFIG.MODEL). */
function listGroqModels() {
  const res = UrlFetchApp.fetch(CONFIG.GROQ_BASE + '/models', {
    headers: { Authorization: 'Bearer ' + getSecret_('GROQ_API_KEY') },
    muteHttpExceptions: true
  });
  if (res.getResponseCode() !== 200) {
    console.log('HTTP ' + res.getResponseCode() + ': ' + res.getContentText().slice(0, 300));
    return;
  }
  const ids = JSON.parse(res.getContentText()).data.map(function (x) { return x.id; }).sort();
  console.log('Available models:\n' + ids.join('\n'));
}

function retryAfterSeconds_(res) {
  const headers = res.getAllHeaders ? res.getAllHeaders() : {};
  for (const k in headers) {
    if (k.toLowerCase() === 'retry-after') return Math.ceil(Number(headers[k])) || 0;
  }
  return 0;
}

/** Groq Whisper transcription (verbose_json gives us the audio duration). */
function transcribe_(blob) {
  const res = UrlFetchApp.fetch(CONFIG.GROQ_BASE + '/audio/transcriptions', {
    method: 'post',
    headers: { Authorization: 'Bearer ' + getSecret_('GROQ_API_KEY') },
    payload: {
      file: blob,
      model: CONFIG.STT_MODEL,
      response_format: 'verbose_json',
      temperature: '0',
      // Style prompt nudges Whisper to keep disfluencies instead of cleaning them up.
      prompt: 'Umm, let me think, like, hmm... okay, so, you know, I mean, basically, uh, here is what I think.'
    },
    muteHttpExceptions: true
  });
  if (res.getResponseCode() !== 200) {
    throw new Error('Whisper HTTP ' + res.getResponseCode() + ': ' + res.getContentText().slice(0, 200));
  }
  const data = JSON.parse(res.getContentText());
  return { text: (data.text || '').trim(), duration: data.duration };
}

/* ------------------------------------------------------------------ */
/* NEWS GROUNDING (free RSS)                                           */
/* ------------------------------------------------------------------ */

/**
 * Fetches headlines in parallel. Each item gets a short ID (L1, L2...) so the model never has to
 * copy long URLs; resolveLinks_() swaps the IDs for real links after generation.
 */
function collectNews_() {
  const requests = NEWS_TOPICS.map(function (t) {
    return { url: googleNewsUrl_(t.query), muteHttpExceptions: true };
  });
  YOUTUBE_CHANNEL_IDS.forEach(function (id) {
    requests.push({ url: 'https://www.youtube.com/feeds/videos.xml?channel_id=' + id, muteHttpExceptions: true });
  });
  const responses = UrlFetchApp.fetchAll(requests);

  const links = {};
  const seen = {};
  const blocks = [];
  const videoLines = [];
  let n = 0;

  const addItem = function (item) {
    const k = item.title.toLowerCase();
    if (!item.title || !item.link || seen[k]) return null;
    seen[k] = true;
    const id = 'L' + (++n);
    links[id] = item.link;
    return id + ' | ' + item.title.slice(0, 140) + (item.source ? ' (' + item.source + ')' : '');
  };

  NEWS_TOPICS.forEach(function (topic, i) {
    const lines = [];
    parseGoogleNews_(responses[i]).forEach(function (item) {
      if (lines.length >= CONFIG.HEADLINES_PER_TOPIC) return;
      const line = addItem(item);
      if (line) lines.push(line);
    });
    if (lines.length) blocks.push('## ' + topic.label + '\n' + lines.join('\n'));
  });

  for (let j = NEWS_TOPICS.length; j < responses.length; j++) {
    parseYouTube_(responses[j]).slice(0, 2).forEach(function (item) {
      const line = addItem(item);
      if (line) videoLines.push(line);
    });
  }
  if (videoLines.length) blocks.push('## VIDEOS (recent uploads)\n' + videoLines.join('\n'));

  if (!n) throw new Error('No news could be fetched from the RSS feeds.');
  return { text: blocks.join('\n\n'), links: links };
}

function googleNewsUrl_(query) {
  return 'https://news.google.com/rss/search?q=' + encodeURIComponent(query + ' when:1d') +
    '&hl=en-IN&gl=IN&ceid=IN:en';
}

function parseGoogleNews_(res) {
  if (!res || res.getResponseCode() !== 200) return [];
  try {
    const channel = XmlService.parse(res.getContentText()).getRootElement().getChild('channel');
    return channel.getChildren('item').map(function (it) {
      const srcEl = it.getChild('source');
      const source = srcEl ? srcEl.getText() : '';
      let title = it.getChildText('title') || '';
      if (source && title.slice(-(source.length + 3)) === ' - ' + source) {
        title = title.slice(0, -(source.length + 3));
      }
      return { title: title, link: it.getChildText('link') || '', source: source };
    });
  } catch (err) {
    return [];
  }
}

function parseYouTube_(res) {
  if (!res || res.getResponseCode() !== 200) return [];
  try {
    const atom = XmlService.getNamespace('http://www.w3.org/2005/Atom');
    const root = XmlService.parse(res.getContentText()).getRootElement();
    const channelName = root.getChildText('title', atom) || 'YouTube';
    const cutoff = Date.now() - 7 * 24 * 3600 * 1000;
    return root.getChildren('entry', atom).filter(function (e) {
      const published = Date.parse(e.getChildText('published', atom) || '');
      return !published || published >= cutoff;
    }).map(function (e) {
      const linkEl = e.getChild('link', atom);
      return {
        title: e.getChildText('title', atom) || '',
        link: linkEl ? linkEl.getAttribute('href').getValue() : '',
        source: channelName + ' (YouTube)'
      };
    });
  } catch (err) {
    return [];
  }
}

/** Replaces [L7] or [L7, L9] with the real URL(s). */
function resolveLinks_(text, links) {
  return text.replace(/\[(L\d+(?:\s*[,;]\s*L\d+)*)\]/g, function (m, group) {
    return group.split(/\s*[,;]\s*/).map(function (id) { return links[id] || ''; })
      .filter(Boolean).join(' ');
  });
}

function stripLinkTokens_(text) {
  return text.replace(/\s*\[L\d+(?:\s*[,;]\s*L\d+)*\]/g, '');
}

/* ------------------------------------------------------------------ */
/* CHAT MEMORY (CacheService, so quiz answers can be graded)           */
/* ------------------------------------------------------------------ */
function loadHistory_() {
  try {
    return JSON.parse(CacheService.getScriptCache().get('chat_history') || '[]');
  } catch (e) {
    return [];
  }
}

function saveHistory_(history) {
  const h = history.map(function (m) {
    return { role: m.role, content: String(m.content).slice(0, CONFIG.HISTORY_CHARS) };
  });
  while (h.length > CONFIG.HISTORY_MESSAGES) h.shift();
  while (h.length > 1 && JSON.stringify(h).length > CONFIG.HISTORY_TOTAL_CHARS) h.shift();
  CacheService.getScriptCache().put('chat_history', JSON.stringify(h), 21600);
}

function appendHistory_(role, content) {
  const h = loadHistory_();
  h.push({ role: role, content: content });
  saveHistory_(h);
}

/* ------------------------------------------------------------------ */
/* TELEGRAM HELPERS                                                    */
/* ------------------------------------------------------------------ */
function sendTelegramMessage_(text) {
  const url = 'https://api.telegram.org/bot' + getSecret_('TELEGRAM_BOT_TOKEN') + '/sendMessage';
  const chunks = splitMessage_(text, 3900);
  chunks.forEach(function (chunk, i) {
    if (i > 0) Utilities.sleep(500);
    UrlFetchApp.fetch(url, {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify({
        chat_id: getSecret_('TELEGRAM_CHAT_ID'),
        text: chunk,
        link_preview_options: { is_disabled: true }
      }),
      muteHttpExceptions: true
    });
  });
}

/** Splits on paragraph / line / word boundaries instead of mid-sentence. */
function splitMessage_(text, max) {
  const chunks = [];
  let rest = String(text).trim();
  while (rest.length > max) {
    let cut = rest.lastIndexOf('\n\n', max);
    if (cut < max * 0.5) cut = rest.lastIndexOf('\n', max);
    if (cut < max * 0.5) cut = rest.lastIndexOf(' ', max);
    if (cut < 1) cut = max;
    chunks.push(rest.slice(0, cut).trim());
    rest = rest.slice(cut).trim();
  }
  if (rest) chunks.push(rest);
  return chunks;
}

function downloadTelegramFile_(fileId) {
  const token = getSecret_('TELEGRAM_BOT_TOKEN');
  const info = JSON.parse(UrlFetchApp.fetch(
    'https://api.telegram.org/bot' + token + '/getFile?file_id=' + encodeURIComponent(fileId)).getContentText());
  if (!info.ok) throw new Error('Telegram getFile failed');
  return UrlFetchApp.fetch('https://api.telegram.org/file/bot' + token + '/' + info.result.file_path).getBlob();
}

/* ------------------------------------------------------------------ */
/* UTILITIES & SETUP                                                   */
/* ------------------------------------------------------------------ */
function getSecret_(key) {
  const value = PropertiesService.getScriptProperties().getProperty(key);
  if (!value) throw new Error('Missing Script Property: ' + key);
  return value;
}

function runSafely_(label, fn) {
  try {
    fn();
  } catch (err) {
    console.error(label + ' failed: ' + err);
    try { sendTelegramMessage_('⚠️ ' + label + ' failed: ' + String(err.message || err).slice(0, 300)); } catch (ignore) {}
  }
}

