/* 1. MORNING BRIEFING & MIND-BODY PROTOCOL (daily, 7:30 AM IST)       */
/* ------------------------------------------------------------------ */
function sendMorningBriefing() {
  runSafely_('Morning briefing', function () {
    const today = Utilities.formatDate(new Date(), CONFIG.TIMEZONE, 'EEEE, MMMM d, yyyy');
    const news = collectNews_();

    // Part 1: digest, grounded in fetched headlines
    const digestRaw = callGroq_([{
      role: 'user',
      content:
        'Today is ' + today + '. Below are fresh headlines (format: ID | title (source)).\n' +
        'Write my Daily Morning Digest using ONLY these items.\n' +
        '- One section per topic label that has items. Pick the 2-3 most significant stories per section, ' +
        'each as 1-2 cautious sentences (you only see headlines, so do not add details they do not state), ' +
        'followed by its ID in square brackets, e.g. [L12].\n' +
        '- For the VOICES sections and any VIDEO items, say who is in the news or what the video is, and add the ID.\n' +
        '- Finish with BIG PICTURE: 3 bullets connecting the dots across sections.\n\n' +
        news.text
    }], { temperature: 0.4, maxTokens: 2600 });
    const digestPlain = stripLinkTokens_(digestRaw);
    sendTelegramMessage_('☀️ MORNING DIGEST — ' + today + '\n\n' + resolveLinks_(digestRaw, news.links));

    // Part 2: active-recall quiz built from the digest
    Utilities.sleep(CONFIG.PAUSE_MS);
    const quiz = callGroq_([{
      role: 'user',
      content:
        'Based ONLY on this digest, write 5 questions: 2 comprehension, 2 synthesis (connect two different stories), ' +
        '1 prediction / critical-thinking. Number them 1-5. Do NOT include answers. ' +
        'End with: "Reply with all your answers in one message and I will grade them."\n\nDIGEST:\n' + digestPlain
    }], { temperature: 0.6, maxTokens: 900 });
    sendTelegramMessage_('🧠 ACTIVE RECALL QUIZ\n\n' + quiz);
    appendHistory_('assistant',
      'MORNING DIGEST (for grading):\n' + digestPlain.slice(0, 2500) + '\n\nQUIZ I ASKED:\n' + quiz);

    // Part 3: daily optimisation protocol
    Utilities.sleep(CONFIG.PAUSE_MS);
    const protocol = callGroq_([{
      role: 'user',
      content:
        'Today is ' + today + '. Design my Daily Optimization Protocol: ' +
        '1) brain-boosting diet for the day (South Indian / Bengaluru friendly, with specific meals), ' +
        '2) a 25-minute exercise routine, 3) a 10-minute meditation & mindfulness protocol, ' +
        '4) one creative thinking task, 5) one cognitive brain-sharpening drill. Keep it practical and time-boxed.'
    }], { temperature: 0.7, maxTokens: 1500 });
    sendTelegramMessage_('🌿 TODAY\'S MIND-BODY PROTOCOL\n\n' + protocol);
  });
}

