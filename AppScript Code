/** Run once after deploying the web app and saving WEBAPP_URL in Script Properties. */
function setTelegramWebhook() {
  const url = PropertiesService.getScriptProperties().getProperty('WEBAPP_URL') || ScriptApp.getService().getUrl();
  if (!url) throw new Error('Set the WEBAPP_URL Script Property to your web app /exec URL first.');
  const res = UrlFetchApp.fetch('https://api.telegram.org/bot' + getSecret_('TELEGRAM_BOT_TOKEN') + '/setWebhook', {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify({ url: url, allowed_updates: ['message'], drop_pending_updates: true }),
    muteHttpExceptions: true
  });
  console.log(res.getContentText());
}

